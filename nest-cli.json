{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": ["mail/templates/**/*"],
    "assets": ["mailers/data/**/*"],
    "watchAssets": true
  },
  "resolutions": {
    "strip-ansi": "6.0.0",
    "string-width": "4.2.3"
  }
}
